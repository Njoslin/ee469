module PipelineRegister3_Execution_MemoryAccess(clk, reset, enable,

EX_3_CBZBranch, EX_3_MemRead, EX_3_MemtoReg, EX_3_MemWrite, EX_3_RegWrite, 

EX_3_UnconditionalBranch, EX_3_BranchLessThan, EX_3_BranchLink, EX_3_BranchRegister, EX_3_CBZBranch, 

MEM_4_CBZBranch, MEM_4_MemRead, MEM_4_MemtoReg, MEM_4_MemWrite, MEM_4_ALUSrc, MEM_4_RegWrite, 

MEM_4_UnconditionalBranch, MEM_4_BranchLessThan, MEM_4_BranchLink, MEM_4_BranchRegister,

EX_3_shiftedInstructionUpdate, MEM_4_shiftedInstructionUpdate,

EX_3_flagNeg, EX_3_flagZero, EX_3_flagOverflow, EX_3_flagCarryO,

MEM_4_flagNeg, MEM_4_flagZero, MEM_4_flagOverflow, MEM_4_flagCarryO,

EX_3_cbzZero, MEM_4_cbzZero,

EX_3_ALUResult, MEM_4_ALUResult, EX_3_reg_Address, MEM_4_reg_Address);
/*
WB,MEM Control signals
Control Signals Not Needed
-ALUSrc
-ALUOp 
these are used within the execution stage
-Reg2Loc used in ID stage. Needed to select what the second operand Rm will be 
*/

	//default DFF inputs.
	input logic clk, reset, enable; 

	//control inputs to EX HALF
	input logic  EX_3_CBZBranch, EX_3_MemRead, EX_3_MemtoReg, EX_3_MemWrite, EX_3_RegWrite, 
	
	EX_3_UnconditionalBranch, EX_3_BranchLessThan, EX_3_BranchLink, EX_3_BranchRegister;

	//control outputs to the MEM Half
	output logic MEM_4_CBZBranch, MEM_4_MemRead, MEM_4_MemtoReg, MEM_4_MemWrite, MEM_4_ALUSrc, MEM_4_RegWrite, 
	
	MEM_4_UnconditionalBranch, MEM_4_BranchLessThan, MEM_4_BranchLink, MEM_4_BranchRegister;

	//flag register from ALU, may not need but implementing cant hurt
	input logic EX_3_flagNeg, EX_3_flagZero, EX_3_flagOverflow, EX_3_flagCarryO;

	output logic MEM_4_flagNeg, MEM_4_flagZero, MEM_4_flagOverflow, MEM_4_flagCarryO;


	//seperate zero signal for cbz
	input logic EX_3_cbzZero;
	
	output logic MEM_4_cbzZero;
	
	
	//pc + branchAddress
	input logic [63:0] EX_3_shiftedInstructionUpdate;

	output logic [63:0] MEM_4_shiftedInstructionUpdate;

	//ALU result
	input logic [63:0] EX_3_ALUResult;

	output logic [63:0] MEM_4_ALUResult;


	//register address via instruction field Rd/Rt --> [4:0]
	input logic [4:0] EX_3_reg_Address;

	output logic [4:0] MEM_4_reg_Address;
	
	
//control inputs
//CBZ
Uni_Enable_DFF #(.WIDTH(1)) CBZBranch_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_CBZBranch), .q(MEM_4_CBZBranch));

//MemRead
Uni_Enable_DFF #(.WIDTH(1)) MemRead_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_MemRead), .q(MEM_4_MemRead));

//MemtoReg
Uni_Enable_DFF #(.WIDTH(1)) MemtoReg_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_MemtoReg), .q(MEM_4_MemtoReg));

//MemWrite
Uni_Enable_DFF #(.WIDTH(1)) MemWrite_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_MemWrite), .q(MEM_4_MemWrite));

//RegWrite
Uni_Enable_DFF #(.WIDTH(1)) RegWrite_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_RegWrite), .q(MEM_4_RegWrite));

//UnconditionalBranch
Uni_Enable_DFF #(.WIDTH(1)) UnconditionalBranch_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_UnconditionalBranch), .q(MEM_4_UnconditionalBranch));

//BranchLessThan
Uni_Enable_DFF #(.WIDTH(1)) BranchLessThan_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_BranchLessThan), .q(MEM_4_BranchLessThan));

//BranchLink
Uni_Enable_DFF #(.WIDTH(1)) BranchLink_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_BranchLink), .q(MEM_4_BranchLink));



//flags and CBZzero
//negative
Uni_Enable_DFF #(.WIDTH(1)) negativeFlag_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_flagNeg), .q(MEM_4_flagNeg));

//zero 
Uni_Enable_DFF #(.WIDTH(1)) zeroFlag_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_flagZero), .q(MEM_4_flagZero));

//overflow
Uni_Enable_DFF #(.WIDTH(1)) overflowFlag_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_flagOverflow), .q(MEM_4_flagOverflow));

//carryO
Uni_Enable_DFF #(.WIDTH(1)) carryOutFlag_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_flagCarryO), .q(MEM_4_flagCarryO));

//cbzZero --> different from zero flag, used to check current result is zero or not
Uni_Enable_DFF #(.WIDTH(1)) CBZFlag_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_cbzZero), .q(MEM_4_cbzZero));

//pc + branch address
Uni_Enable_DFF #(.WIDTH(64)) pc_plus_branch_address_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_shiftedInstructionUpdate), .q(MEM_4_shiftedInstructionUpdate));


//ALU result
Uni_Enable_DFF #(.WIDTH(64)) alu_Result_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_ALUResult), .q(MEM_4_ALUResult));


//register address via instruction field Rd/Rt --> [4:0]
Uni_Enable_DFF #(.WIDTH(5)) registerAddress_EX_MEM(.clk(clk), .reset(reset), .enable(enable),
.writeData(EX_3_reg_Address), .q(MEM_4_reg_Address));
	

endmodule
