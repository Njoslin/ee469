//inputs readData 1 and 2
module bitwiseAnd(readData1, readData2, result, a);
	input logic [63:0] readData1, readData2;
	input logic [2:0] a; 
	output logic [63:0] result; 
	
	logic enable;
	
	and c(enable, a[2], ~a[1], ~a[0]);
	
		genvar i;
		
		generate
		
		for(i = 0; i < 63; i++) begin: copyBits
			and #0.05 b(result[i], readData1[i], readData2[i]);
		end
	endgenerate
endmodule

	
	
	