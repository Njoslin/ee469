endmodule
*/
`timescale 1ns/10ps

module sixtyFour_Adder_testbench();

  logic [63:0] a, b;
  logic [2:0] ac;
  logic cin;
  logic [63:0] result;
  logic cout, overflow, negative;

  // Instantiate the adder
  sixtyFour_adder dut (
    .a(a),
    .b(b),
    .ac(ac),
    .cin(cin),
    .result(result),
    .cout(cout),
    .overflow(overflow),
    .negative(negative)
  );

  task run_test(
    input [63:0] ta, tb,
    input [2:0] tac,
    input tcin,
    input [63:0] expected_result,
    input expected_cout,
    input expected_overflow,
    input expected_negative,
    input string test_name
  );
    begin
      a = ta; b = tb; ac = tac; cin = tcin;
      #10;
      $display("Running %s", test_name);
      $display("a = %h, b = %h, ac = %b, cin = %b", a, b, ac, cin);
      $display("Result = %h, Expected = %h", result, expected_result);
      $display("cout = %b, overflow = %b, negative = %b", cout, overflow, negative);
      assert(result === expected_result && cout === expected_cout &&
             overflow === expected_overflow && negative === expected_negative)
      else $fatal(1,"FAILED %s", test_name);
    end
  endtask

  initial begin
    $display("Starting sixtyFour_adder tests...");

    // Test simple add: 1 + 1 = 2
    run_test(64'h1, 64'h1, 3'b010, 1'b0,
             64'h2, 1'b0, 1'b0, 1'b0, "Simple Addition");

    // Test carry out: FFFF... + 1 = 0 with carry
    run_test(64'hFFFFFFFFFFFFFFFF, 64'h1, 3'b010, 1'b0,
             64'h0000000000000000, 1'b1, 1'b0, 1'b0, "Carry Out Check");

    // Test overflow: 7FFF... + 1 = 8000... (overflow)
    run_test(64'h7FFFFFFFFFFFFFFF, 64'h1, 3'b010, 1'b0,
             64'h8000000000000000, 1'b0, 1'b1, 1'b1, "Signed Overflow");

    // Test subtraction: 3 - 2 = 1
    run_test(64'h3, 64'h2, 3'b011, 1'b0,
             64'h1, 1'b0, 1'b0, 1'b0, "Subtraction Test");

    // Test negative result: 2 - 3 = -1
    run_test(64'h2, 64'h3, 3'b011, 1'b0,
             64'hFFFFFFFFFFFFFFFF, 1'b0, 1'b0, 1'b1, "Negative Result");

    $display("All sixtyFour_adder tests passed!");
    $finish;
  end

endmodule
